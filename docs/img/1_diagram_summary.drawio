        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=center;" value="&lt;b&gt;BM25 vs TD-IDF&lt;/b&gt;&lt;br&gt;Ambos son &lt;b&gt;algoritmos de retrievel&lt;/b&gt; (basado en palabras exactas, no en significado).&amp;nbsp;" vertex="1">
          <mxGeometry height="61" width="170" x="-962.99" y="1070" as="geometry" />
        </mxCell>
        <mxCell id="aI3Ot4zGlF9XPwriC0AH-12" edge="1" parent="1" source="aI3Ot4zGlF9XPwriC0AH-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;curved=1;" target="aI3Ot4zGlF9XPwriC0AH-9">
          <mxGeometry relative="1" as="geometry" />
